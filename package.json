{
  "name": "zeroroute",
  "version": "0.1.2",
  "description": "The $0/mo Multi-Cloud AI Gateway for Solo Founders & Startups. Zero cost, zero downtime, zero dependencies.",
  "author": "Amjad P A <hire.amjad@gmail.com> (https://amjad.mapki.in)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/amjadlle/zeroroute.git"
  },
  "bugs": {
    "url": "https://github.com/amjadlle/zeroroute/issues"
  },
  "homepage": "https://github.com/amjadlle/zeroroute#readme",
  "keywords": [
    "ai-gateway",
    "llm-router",
    "free-ai",
    "openai-proxy",
    "groq",
    "sambanova",
    "mistral",
    "gemini",
    "nvidia-nim",
    "cloudflare-ai",
    "failover",
    "streaming-sse",
    "zero-dependencies"
  ],
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env --import tsx/esm src/server.ts",
    "build": "node scripts/sync-static.js && tsc",
    "start": "node --env-file=.env dist/server.js",
    "deploy": "node scripts/sync-static.js && tsc && npx wrangler deploy",
    "deploy:preview": "npx wrangler dev",
    "discover": "node --env-file=.env scripts/discover-models.js",
    "test:providers": "node --env-file=.env scripts/test-providers.js"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
