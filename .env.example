# Server & Security
PORT=8787

# Chat authentication — clients & widgets must send this as Bearer token.
# If not set, the gateway runs in PUBLIC mode (anyone can send chat requests).
ROUTER_API_KEY=your-router-api-key

# Admin authentication — protects /api/* endpoints and the dashboard.
# MUST be different from ROUTER_API_KEY in production.
ADMIN_KEY=your-admin-key-different-from-router-key

# CORS — controls which browser origins can call this gateway.
# Options:
#   *                  → allow any origin (open/public deployments)
#   *.yourdomain.com   → all subdomains of your domain (+ apex)
#   https://app.io     → one exact domain
#   Comma-separated list of patterns is also supported.
CORS_ORIGIN=*

# Routing & Failover
TIMEOUT_MS=8000
COOLDOWN_MS=60000
PROVIDER_ORDER=sambanova,groq,mistral,openrouter,gemini,nvidia,cloudflare,cohere

# 1. SambaNova Cloud — https://cloud.sambanova.ai
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=gemma-4-31B-it

# 2. Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# 3. Mistral AI — https://console.mistral.ai
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# 4. OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# 5. Google Gemini — https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# 6. NVIDIA NIM — https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# 7. Cloudflare Workers AI — https://dash.cloudflare.com
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# 8. Cohere — https://dashboard.cohere.com
COHERE_API_KEY=
COHERE_MODEL=command-r-plus-08-2024
