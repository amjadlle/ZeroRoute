# Server & Security
PORT=8787
ROUTER_API_KEY=your-secret-api-key-for-clients
ADMIN_KEY=your-admin-key-for-dashboard
CORS_ORIGIN=*

# Routing & Failover Intelligence
TIMEOUT_MS=8000
COOLDOWN_MS=60000
PROVIDER_ORDER=sambanova,groq,mistral,openrouter,gemini,nvidia,cloudflare,cohere

# 1. SambaNova (Free fast inference)
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=gemma-4-31B-it

# 2. Groq (Ultra-fast inference)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# 3. Mistral AI
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# 4. OpenRouter (Free tier models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# 5. Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# 6. NVIDIA NIM
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# 7. Cloudflare Workers AI
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# 8. Cohere
COHERE_API_KEY=
COHERE_MODEL=command-r-plus-08-2024
